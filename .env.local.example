# Smoke profile — 10 tenants, 5K spans, 10K items per tenant (~500 MB compressed)
# Copy to .env and source before running: source .env

export TENANT_COUNT=10
export SPANS_PER_TENANT=5000
export ITEMS_PER_TENANT=10000
export CONVERSATIONS_PER_TENANT=500

# Mini profile — 20 tenants, 50K spans, 100K items per tenant (~12 GB compressed)
# export TENANT_COUNT=20
# export SPANS_PER_TENANT=50000
# export ITEMS_PER_TENANT=100000
# export CONVERSATIONS_PER_TENANT=5000

# DB connection (defaults match docker-compose.yml)
# export GREPTIMEDB_URL=postgres://greptime@localhost:4003/public
# export GREPTIMEDB_PROMETHEUS_URL=http://localhost:4000/metrics
